# Postgres connection string from Supabase: Project Settings -> Database -> Connection string
# Use the "Direct connection" string (port 5432), NOT "Transaction pooler" (port 6543) —
# Prisma Migrate needs a direct, non-pooled connection. Set the SAME value for both vars below;
# DIRECT_URL exists only because Prisma's schema requires it to be a separate name.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase Project Settings -> API
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[service_role key — server-side only, keep secret]"

# Supabase Project Settings -> API -> JWT Secret (used to verify tokens the frontend sends)
SUPABASE_JWT_SECRET="[your JWT secret]"

# Local dev port (Railway/Render set PORT automatically in production)
PORT=4000
